    "inherits": false,
    "mechanism": "CSS property override",
    "expansion": "Bootstrap has no public badge foreground variable; the adapter sets color with !important.",
    "mappings": [
      { "source": "--kroma-color-on-primary", "target": "color", "state": "default" }
    ]
  },
  {
    "component": "card",
