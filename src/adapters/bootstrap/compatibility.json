[
  {
    "component": "body",
    "scope": "[data-kroma-theme]",
    "inherits": true,
    "mechanism": "runtime CSS custom properties",
    "expansion": "Inherited by the document subtree unless a component publishes a local --bs-* contract.",
    "mappings": [
      { "source": "--kroma-color-surface-canvas", "target": "--bs-body-bg", "state": "default" },
      { "source": "--kroma-color-content-primary", "target": "--bs-body-color", "state": "default" },
      { "source": "--kroma-color-border-default", "target": "--bs-border-color", "state": "default" }
    ]
  },
  {
    "component": "utilities",
    "scope": "[data-kroma-theme]",
    "inherits": true,
    "mechanism": "runtime CSS custom properties",
