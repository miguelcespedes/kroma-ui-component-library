    "mappings": [
      { "source": "--kroma-color-primary-rgb", "target": "--bs-primary-rgb", "state": "default" },
      { "source": "--kroma-color-success-rgb", "target": "--bs-success-rgb", "state": "default" },
      { "source": "--kroma-color-link-rgb", "target": "--bs-link-color-rgb", "state": "default" }
    ]
  },
  {
    "component": "button",
