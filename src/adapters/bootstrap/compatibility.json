    "inherits": false,
    "mechanism": "runtime local CSS variables",
    "expansion": "The adapter repeats the contract for primary, success, danger, info and warning.",
    "mappings": [
      { "source": "--kroma-color-primary", "target": "--bs-btn-color", "state": "default" },
